# ===== Dayflow API environment =====
# Copy to .env and fill in real values. Never commit .env.

# ---- Database (Supabase Postgres) ----
# Paste your Supabase project connection string (hosted) here, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# or the local/self-managed equivalent. Prisma uses this.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?schema=public"

# ---- Auth / JWT ----
JWT_SECRET="change-me-to-a-long-random-string-32+-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- Server ----
NODE_ENV="development"
PORT=4000
# CORS allow-list for the web client (comma-separated).
CLIENT_ORIGIN="http://localhost:5173"
# Base URL used in email verification links (web app).
VERIFY_BASE_URL="http://localhost:5173"

# ---- SMTP (email) ----
# In development, if these are blank the mailer logs to console instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Dayflow <no-reply@dayflow.local>"

# ---- Storage ----
# Storage backend: "local" (default, works out of the box) or "supabase".
STORAGE_DRIVER="local"
STORAGE_UPLOADS_DIR="uploads"
# Used only when STORAGE_DRIVER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_PROFILE="profile-pictures"
SUPABASE_BUCKET_DOCS="employee-documents"

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS="900000"   # 15 min
RATE_LIMIT_MAX="300"            # per window
AUTH_RATE_LIMIT_MAX="20"        # stricter for auth routes