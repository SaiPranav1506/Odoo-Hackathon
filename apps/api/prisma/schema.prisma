// Dayflow — Prisma schema (PostgreSQL via Supabase)
// Docs: docs/02-database-schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR
}

enum LeaveType {
  PAID
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  EMAIL_VERIFICATION
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  PROFILE_UPDATED
  SALARY_UPDATED
  PAYSLIP_ISSUED
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  passwordHash         String
  role                 Role      @default(EMPLOYEE)
  emailVerifiedAt      DateTime?
  verificationToken    String?   @unique
  verificationTokenExpiry DateTime?
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?
  refreshTokenHash     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  profile              EmployeeProfile?
  notifications        Notification[]
  decisions            LeaveRequest[]   @relation("LeaveDecision")
  auditActions         AuditLog[]       @relation("AUDIT_ACTOR")
}

model EmployeeProfile {
  id                 Int             @id @default(autoincrement())
  userId             Int             @unique
  employeeId         String          @unique // human id e.g. EMP-0001
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  gender             String?
  phone              String?
  personalEmail      String?
  address            String?
  department         String?
  jobTitle           String?
  hireDate           DateTime?
  employmentType     String?
  status             EmployeeStatus  @default(ACTIVE)
  profilePictureUrl  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance         AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  leaveBalance       LeaveBalance?
  salaryStructure    SalaryStructure?
  payslips           Payslip[]
  documents          Document[]
  auditLogs          AuditLog[] @relation("AUDIT_SUBJECT")

  @@index([department])
  @@index([status])
}

model AttendanceRecord {
  id             Int              @id @default(autoincrement())
  employeeId     Int
  date           DateTime         @db.Date
  checkInTime    DateTime?
  checkOutTime   DateTime?
  status         AttendanceStatus @default(PRESENT)
  leaveRequestId Int?
  note           String?
  updatedAt      DateTime         @updatedAt
  employee       EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest?    @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
}

model LeaveRequest {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  leaveType    LeaveType
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  days         Int
  reason       String
  status       LeaveStatus  @default(PENDING)
  adminComment String?
  decidedBy    Int?
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decision     User?        @relation("LeaveDecision", fields: [decidedBy], references: [id], onDelete: SetNull)
  attendance   AttendanceRecord[]

  @@index([status])
  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id              Int    @id @default(autoincrement())
  employeeId      Int    @unique
  paidDaysEntitled Int   @default(20)
  paidDaysUsed    Int    @default(0)
  sickDaysUsed    Int    @default(0)
  unpaidDaysUsed  Int    @default(0)
  employee        EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model SalaryStructure {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @unique
  basicPay         Decimal  @db.Decimal(12, 2)
  housingAllowance Decimal? @db.Decimal(12, 2)
  transportAllowance Decimal? @db.Decimal(12, 2)
  otherAllowances  Json?
  taxPercent       Decimal? @db.Decimal(5, 2)
  otherDeductions  Json?
  effectiveFrom    DateTime? @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employee         EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payslip {
  id         Int      @id @default(autoincrement())
  employeeId Int
  period     String // YYYY-MM
  gross      Decimal  @db.Decimal(12, 2)
  net        Decimal  @db.Decimal(12, 2)
  components Json
  issuedAt   DateTime @default(now())
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@index([period])
}

model Notification {
  id            Int              @id @default(autoincrement())
  recipientUserId Int
  type          NotificationType
  title         String
  body          String
  link          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  recipient     User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
}

model Document {
  id         Int    @id @default(autoincrement())
  employeeId Int
  name       String
  type       String
  url        String
  uploadedBy Int? // userId
  createdAt  DateTime @default(now())
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  actorUserId      Int
  subjectEmployeeId Int?
  action           String
  field            String?
  oldValue         Json?
  newValue         Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  actor            User              @relation("AUDIT_ACTOR", fields: [actorUserId], references: [id], onDelete: Restrict)
  subject          EmployeeProfile?  @relation("AUDIT_SUBJECT", fields: [subjectEmployeeId], references: [id], onDelete: SetNull)

  @@index([subjectEmployeeId, createdAt])
  @@index([actorUserId, createdAt])
}